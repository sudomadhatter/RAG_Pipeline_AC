# ──────────────────────────────────────────────────────────────────────────
# Example environment file for Ingestion_pipeline_AvCh
#
# Copy this to  auth_keys/.env  (NOT the repo root — that's where src/config.py
# loads it from, and auth_keys/ is gitignored so secrets never get committed):
#
#     cp .env.example auth_keys/.env
#
# Then fill in real values. Also place your service-account key at
# auth_keys/service-account.json (or point GOOGLE_APPLICATION_CREDENTIALS at it).
# ──────────────────────────────────────────────────────────────────────────

# GCP project that owns the Vertex AI Search stores + Firestore + GCS buckets.
GCP_PROJECT_ID=aviationchat

# Vertex AI Search data store IDs. Defaults (in config.py) point at the live v2
# stores; override here only if you target a different store.
VERTEX_SEARCH_DB1_ID=aviation-curriculum-v2
VERTEX_SEARCH_DB2_ID=aviation-library-v2
VERTEX_SEARCH_LOCATION=global

# Gemini API key — used by the metadata extractor and flashcard formatter.
GEMINI_API_KEY=your-gemini-api-key-here

# OPTIONAL: explicit path to the service-account JSON. If unset, config.py falls
# back to auth_keys/service-account.json relative to the repo root.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
